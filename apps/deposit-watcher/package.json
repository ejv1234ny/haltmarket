{
  "name": "@haltmarket/deposit-watcher",
  "version": "0.1.0",
  "private": true,
  "description": "Watches USDC Transfer events to the Safe hot wallet on Base and calls credit_crypto_deposit RPC.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --build",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'no lint (typecheck covers it)' && exit 0",
    "test": "vitest run",
    "clean": "rimraf dist node_modules .turbo"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.3",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "prom-client": "^15.1.3",
    "viem": "^2.21.10",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "eslint": "^8.57.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
