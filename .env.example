# haltmarket secrets — copy to .env.local (web) or per-app .env; never commit.

# ─────────────────────────────────────────────────────────────
# Supabase (project ref: sqjdfafewyphoroaivqq)
# ─────────────────────────────────────────────────────────────
SUPABASE_PROJECT_REF=sqjdfafewyphoroaivqq
SUPABASE_URL=https://sqjdfafewyphoroaivqq.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Next.js public-facing (must be prefixed NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# ─────────────────────────────────────────────────────────────
# Market data
# ─────────────────────────────────────────────────────────────
POLYGON_API_KEY=

# Nasdaq halt RSS (Phase 2)
NASDAQ_RSS_URL=https://www.nasdaqtrader.com/rss.aspx?feed=tradehalts
HALT_POLL_INTERVAL_SECONDS=3

# ─────────────────────────────────────────────────────────────
# Observability (Phase 1+)
# ─────────────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=

# ─────────────────────────────────────────────────────────────
# Web Push (Phase 6) — VAPID keys generated by operator, see docs/human-tasks.md #14
# ─────────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@haltmarket.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ─────────────────────────────────────────────────────────────
# Email (Phase 6 stub, SendGrid)
# ─────────────────────────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@haltmarket.com

# ─────────────────────────────────────────────────────────────
# Payments / crypto rail (Phase 8)
# ─────────────────────────────────────────────────────────────
# Privy (embedded Base wallets, login)
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Safe multisig addresses on Base Mainnet
HOT_WALLET_ADDRESS=
COLD_WALLET_ADDRESS=

# Alchemy Notify webhook → deposit-watcher
ALCHEMY_API_KEY=
ALCHEMY_SIGNING_KEY=

# Base RPC (public endpoint works, a paid endpoint gives better latency)
BASE_RPC_URL=https://mainnet.base.org
BASE_CHAIN_ID=8453
USDC_BASE_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Legacy stub-provider shims (kept for backwards compat until deposits flip live)
PAYMENT_PROVIDER=stub
PAYMENT_WEBHOOK_SECRET=
COINBASE_COMMERCE_API_KEY=
CIRCLE_API_KEY=
FIREBLOCKS_API_KEY=
FIREBLOCKS_API_SECRET_PATH=

# ─────────────────────────────────────────────────────────────
# Deploy (CI) — referenced by .github/workflows/deploy.yml
# ─────────────────────────────────────────────────────────────
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
RAILWAY_TOKEN=

# ─────────────────────────────────────────────────────────────
# Notifications (Phase 6)
# ─────────────────────────────────────────────────────────────
# Resend (outbound email on halts)
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@haltmarket.com

# Shared secret guarding the notify-halt endpoint against public calls.
NOTIFY_HALT_KEY=

# ─────────────────────────────────────────────────────────────
# KYC vendor (Phase 7)
# ─────────────────────────────────────────────────────────────
# One of: stub | persona | sumsub | stripe
KYC_VENDOR=stub
# Vendor-specific signing secret (Persona signing key / Sumsub webhook secret
# / Stripe whsec_...). Shared across branches to keep env simple.
KYC_WEBHOOK_SECRET=
# Stub-mode bearer for local testing. Only honored when KYC_VENDOR=stub.
KYC_STUB_BEARER=

# ─────────────────────────────────────────────────────────────
# Error reporting (optional)
# ─────────────────────────────────────────────────────────────
# When set, apps/deposit-watcher pipes uncaught exceptions to Sentry. No-op
# when absent. DEPLOY_ENV labels the environment on uploaded events.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE=0.05
DEPLOY_ENV=production

# ─────────────────────────────────────────────────────────────
# Runtime feature flags
# ─────────────────────────────────────────────────────────────
LOG_LEVEL=info
NODE_ENV=development
