{
  "title": "haltmarket — monitor",
  "uid": "haltmarket-monitor",
  "timezone": "browser",
  "schemaVersion": 38,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "tags": ["haltmarket", "monitor"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "prometheus", "value": "prometheus" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Leader",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        { "expr": "haltmarket_monitor_is_leader", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "standby", "color": "orange" } } },
            { "type": "value", "options": { "1": { "text": "leader", "color": "green" } } }
          ]
        }
      },
      "options": { "colorMode": "background" }
    },
    {
      "id": 2,
      "title": "Halts detected / hour",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        { "expr": "rate(haltmarket_monitor_halts_total[10m]) * 3600", "refId": "A", "legendFormat": "halts/hr" }
      ]
    },
    {
      "id": 3,
      "title": "Classify rejections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        { "expr": "rate(haltmarket_monitor_halts_rejected_total[10m])", "refId": "A", "legendFormat": "{{reason}}" }
      ]
    },
    {
      "id": 4,
      "title": "Poll loop + Polygon errors",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        { "expr": "rate(haltmarket_monitor_poll_errors_total[5m])", "refId": "A", "legendFormat": "poll errors/s" },
        { "expr": "rate(haltmarket_monitor_polygon_errors_total[5m])", "refId": "B", "legendFormat": "polygon errors/s" }
      ]
    },
    {
      "id": 5,
      "title": "RSS fetch latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        { "expr": "haltmarket_monitor_last_poll_ms", "refId": "A", "legendFormat": "last poll (ms)" }
      ]
    }
  ]
}
